# --- Public address of this service (no trailing slash). Same domain as OpenProject, under /attendance
BASE_URL=https://pm.keenable.io/attendance
# Long random string; generate with: openssl rand -hex 32
SECRET_KEY=change-me

# --- OpenProject (optional, read only). Leave both empty to run without OpenProject.
#     API token of an OpenProject admin user: avatar > My account > Access tokens > API
OP_URL=https://pm.keenable.io
OP_API_KEY=change-me

# --- Keycloak (same realm OpenProject uses)
OIDC_ISSUER=https://keycloak.example.com/realms/your-realm
OIDC_CLIENT_ID=attendance
OIDC_CLIENT_SECRET=change-me

# --- Database. Use the same PostgreSQL server as OpenProject, but a SEPARATE database and user (see GO-LIVE.md).
#     Leave empty to keep data in a SQLite file in the container volume instead.
DATABASE_URL=postgresql://attendance:change-me@openproject-db:5432/attendance

# --- Keycloak roles (optional). Anyone holding these realm or client roles gets the matching access here.
KC_ADMIN_ROLE=attendance-admin
KC_MANAGER_ROLE=attendance-manager

# --- Admins: can do everything, including giving access to TL/PMs and managers
ADMIN_EMAILS=you@example.com

# --- Attendance rules
TZ_NAME=Asia/Kolkata
SHIFT_START=09:30
GRACE_MIN=15
SHIFT_HOURS=9
WEEKLY_OFF=Sat,Sun
LEAVE_TYPES=Casual Leave,Sick Leave,Earned Leave,Comp Off,Half Day,Other

# --- Daily summary email (leave SUMMARY_TO empty to switch it off)
SUMMARY_TO=you@example.com
SUMMARY_TIME=11:00
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change-me@example.com
SMTP_PASSWORD=change-me
SMTP_FROM=change-me@example.com
